<view class="page-container"><view wx:if="{{a}}" class="login-tip"><text>请先登录后查看足迹</text></view><view wx:else class="content-box"><view wx:if="{{b}}" class="map-section"><canvas canvas-id="routeMap" id="routeMap" class="route-canvas" width="{{c}}" height="{{d}}"></canvas><view class="map-actions"><button class="action-btn save-img" bindtap="{{e}}">保存图片</button><button class="action-btn play-dynamic" bindtap="{{f}}">▶ 看动态版</button></view></view><view class="stats-section"><view class="stats-box"><view class="stat-item"><view class="stat-value">{{g}}</view><view class="stat-label">去过的省份</view></view><view class="stat-item"><view class="stat-value">{{h}}</view><view class="stat-label">参加场次</view></view></view><view class="province-list"><view class="list-title">足迹详情</view><view wx:for="{{i}}" wx:for-item="province" wx:key="d" class="province-item" bindtap="{{province.e}}"><view class="province-info"><view class="province-name">{{province.a}}</view><view class="province-count">{{province.b}} 场</view></view><view class="province-cities"><text wx:for="{{province.c}}" wx:for-item="city" wx:key="b" class="city-tag">{{city.a}}</text></view></view><view wx:if="{{j}}" class="empty-box"><view class="empty-icon">🗺️</view><text class="empty-text">还没有足迹记录</text><text class="empty-desc">参加演唱会或音乐节后会自动生成足迹</text></view></view></view></view><view wx:if="{{k}}" class="loading-box"><text>加载中...</text></view><view wx:if="{{l}}" class="popup-mask" bindtap="{{m}}"></view><view wx:if="{{n}}" class="popup-box"><view class="popup-header"><text class="popup-title">{{o}}</text><text class="popup-close" bindtap="{{p}}">×</text></view><view class="popup-body"><view class="popup-subtitle">共 {{q}} 场</view><view wx:for="{{r}}" wx:for-item="record" wx:key="f" class="record-item"><view class="record-info"><view class="record-type-tag">{{record.a}}</view><view class="record-city">{{record.b}}</view><view class="record-time">{{record.c}}</view></view><view class="record-actions"><view class="action-btn detail-btn" bindtap="{{record.d}}">查看详情</view><view class="action-btn ticket-btn" bindtap="{{record.e}}">生成票根</view></view></view></view></view></view>