.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #cff8f5 0%, #e6cffc 100%);
}
.stats-section {
  padding: 20rpx;
}
.login-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  font-size: 28rpx;
  color: #999;
}
.content-box {
  padding-bottom: 40rpx;
}
.stats-box {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.stats-box .stat-item {
  flex: 1;
  text-align: center;
}
.stats-box .stat-item:not(:last-child) {
  border-right: 1rpx solid #f0f0f0;
}
.stats-box .stat-item .stat-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #c62828;
  margin-bottom: 12rpx;
}
.stats-box .stat-item .stat-label {
  font-size: 26rpx;
  color: #666;
}
.map-section {
  margin-bottom: 30rpx;
}
.map-section .section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}
.map-section .route-canvas {
  width: 100%;
  height: 500rpx;
  display: block;
  border-radius: 16rpx;
  background: #e8f8f5;
}
.map-section .map-actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx;
}
.map-section .map-actions .action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}
.map-section .map-actions .action-btn.save-img {
  background: linear-gradient(135deg, #ff6b9d 0%, #c62828 100%);
  color: #fff;
}
.map-section .map-actions .action-btn.play-dynamic {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.province-list .list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #c62828;
}
.province-list .province-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.province-list .province-item:active {
  background: #f5f5f5;
}
.province-list .province-item .province-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.province-list .province-item .province-info .province-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.province-list .province-item .province-info .province-count {
  font-size: 28rpx;
  color: #c62828;
  font-weight: 500;
}
.province-list .province-item .province-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.province-list .province-item .province-cities .city-tag {
  background: #fff8e1;
  color: #666;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}
.province-list .empty-box {
  text-align: center;
  padding: 100rpx 0;
}
.province-list .empty-box .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.province-list .empty-box .empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}
.province-list .empty-box .empty-desc {
  font-size: 24rpx;
  color: #bbb;
  display: block;
}
.loading-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 30rpx 50rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}
.popup-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 680rpx;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.popup-box .popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-box .popup-header .popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.popup-box .popup-header .popup-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}
.popup-box .popup-body {
  overflow-y: auto;
  padding: 24rpx 32rpx;
}
.popup-box .popup-body .popup-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}
.popup-box .popup-body .record-item {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.popup-box .popup-body .record-item:last-child {
  margin-bottom: 0;
}
.popup-box .popup-body .record-item .record-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.popup-box .popup-body .record-item .record-info .record-type-tag {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: #ffe0e6;
  color: #c62828;
  flex-shrink: 0;
}
.popup-box .popup-body .record-item .record-info .record-city {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.popup-box .popup-body .record-item .record-info .record-time {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}
.popup-box .popup-body .record-item .record-actions {
  display: flex;
  gap: 16rpx;
}
.popup-box .popup-body .record-item .record-actions .action-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.popup-box .popup-body .record-item .record-actions .action-btn:active {
  opacity: 0.8;
}
.popup-box .popup-body .record-item .record-actions .detail-btn {
  background: #e3f2fd;
  color: #1976D2;
}
.popup-box .popup-body .record-item .record-actions .ticket-btn {
  background: linear-gradient(135deg, #ff6b9d 0%, #c62828 100%);
  color: #fff;
}