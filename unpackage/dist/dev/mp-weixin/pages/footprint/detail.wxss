.page-container {
  min-height: 100vh;
  background: #0f0a26;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.aurora {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.aurora view {
  position: absolute;
  border-radius: 50%;
  filter: blur(140rpx);
}
.aurora .a1 {
  width: 600rpx;
  height: 600rpx;
  left: -160rpx;
  top: -200rpx;
  background: radial-gradient(circle, #6d28d9, transparent 65%);
  opacity: 0.5;
}
.aurora .a2 {
  width: 500rpx;
  height: 500rpx;
  right: -120rpx;
  top: 200rpx;
  background: radial-gradient(circle, #0ea5e9, transparent 65%);
  opacity: 0.3;
}
.aurora .a3 {
  width: 600rpx;
  height: 600rpx;
  left: 100rpx;
  bottom: -300rpx;
  background: radial-gradient(circle, #7c3aed, transparent 62%);
  opacity: 0.3;
}
.loading-box, .empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: rgba(225, 220, 255, 0.66);
  font-size: 28rpx;
  z-index: 2;
}
.ticket {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 700rpx;
  border-radius: 48rpx;
  border: 2rpx solid rgba(167, 139, 250, 0.32);
  background: radial-gradient(130% 80% at 12% 0%, rgba(124, 58, 237, 0.38) 0%, transparent 55%), radial-gradient(130% 90% at 88% 100%, rgba(34, 211, 238, 0.2) 0%, transparent 55%), linear-gradient(165deg, #2a1852 0%, #1b1038 52%, #160d30 100%);
  box-shadow: 0 60rpx 120rpx -40rpx rgba(4, 2, 16, 0.85), 0 24rpx 56rpx -28rpx rgba(109, 40, 217, 0.28);
  overflow: hidden;
}
.ticket-overlay {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.022) 0 4rpx, transparent 4rpx 12rpx);
}
.ticket-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 48rpx 60rpx 0;
}
.ticket-head .rule-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.5), transparent);
}
.ticket-head .diamond {
  width: 16rpx;
  height: 16rpx;
  background: #67e8f9;
  transform: rotate(45deg);
  margin: 0 16rpx;
  opacity: 0.8;
  flex: none;
}
.ticket-head .head-text {
  text-align: center;
  flex: none;
}
.ticket-head .head-cn {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #ddd6fe;
}
.ticket-head .head-en {
  display: block;
  font-size: 18rpx;
  letter-spacing: 8rpx;
  color: rgba(225, 220, 255, 0.66);
  margin-top: 8rpx;
}
.ticket-main {
  position: relative;
  z-index: 1;
  padding: 52rpx 68rpx 40rpx;
  text-align: center;
}
.event-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  gap: 24rpx;
}
.event-row .rule-line {
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.7));
}
.event-row .rule-line.reverse {
  background: linear-gradient(90deg, rgba(34, 211, 238, 0.7), transparent);
}
.event-name {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: #c7d2fe;
}
.artist {
  display: block;
  font-size: 100rpx;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 8rpx;
  background: linear-gradient(100deg, #f6f2ff 0%, #b9a9ff 42%, #8be0f7 58%, #f6f2ff 78%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  padding: 8rpx 0 4rpx;
}
.artist-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 10rpx;
  color: rgba(225, 220, 255, 0.66);
  margin-top: 10rpx;
}
.date-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 20rpx;
  margin-top: 36rpx;
}
.date-num {
  font-size: 86rpx;
  font-weight: 700;
  color: #eee9ff;
  letter-spacing: 4rpx;
}
.date-dot {
  color: #67e8f9;
  opacity: 0.75;
  font-size: 36rpx;
}
.divider {
  position: relative;
  z-index: 1;
  height: 2rpx;
  margin: 36rpx 0 0;
  background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.4), transparent);
}
.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 32rpx 0 0;
}
.info {
  width: 50%;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid rgba(167, 139, 250, 0.16);
}
.info:nth-child(odd) {
  border-right: 2rpx solid rgba(167, 139, 250, 0.16);
}
.info:nth-child(-n+2) {
  border-top: none;
}
.info .info-dt {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(225, 220, 255, 0.66);
  margin-bottom: 12rpx;
}
.info .info-dd {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #eee9ff;
  letter-spacing: 2rpx;
}
.info .tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #67e8f9;
  border: 2rpx solid rgba(34, 211, 238, 0.4);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  letter-spacing: 2rpx;
}
.perforation {
  position: relative;
  z-index: 2;
  margin: 40rpx 52rpx 0;
  display: flex;
  align-items: center;
}
.perforation .perf-line {
  flex: 1;
  border-top: 3rpx dashed rgba(167, 139, 250, 0.4);
}
.perforation .mid-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(167, 139, 250, 0.45);
  margin: 0 20rpx;
  flex: none;
}
.perforation .notch {
  position: absolute;
  top: 50%;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  transform: translateY(-50%);
  background: #0f0a26;
  border: 2rpx solid rgba(167, 139, 250, 0.3);
}
.perforation .notch.l {
  left: -52rpx;
}
.perforation .notch.r {
  right: -52rpx;
}
.stamp {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  transform: translate(-50%, -50%) rotate(-9deg);
  padding: 24rpx 40rpx 20rpx;
  text-align: center;
  border-radius: 20rpx;
  border: 4rpx solid transparent;
  background: linear-gradient(rgba(23, 14, 49, 0.62), rgba(23, 14, 49, 0.62)) padding-box, linear-gradient(135deg, #22d3ee, #8b5cf6) border-box;
  box-shadow: 0 16rpx 40rpx -16rpx rgba(34, 211, 238, 0.35);
}
.stamp::after {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  border: 2rpx dashed rgba(158, 234, 251, 0.5);
  border-radius: 12rpx;
}
.stamp .stamp-cn {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  background: linear-gradient(180deg, #a5f3fc 0%, #8be0f7 42%, #c4b5fd 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.stamp .stamp-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #a5b4fc;
}
.ticket-stub {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 44rpx 68rpx 40rpx;
  gap: 32rpx;
}
.stub-left {
  flex: 1;
}
.stub-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(225, 220, 255, 0.66);
  margin-bottom: 16rpx;
}
.stub-no {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #e9e2ff;
  letter-spacing: 4rpx;
}
.stub-num {
  color: #67e8f9;
}
.stub-route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.stub-route .tag {
  color: #8bfae7;
}
.route-arrow {
  display: flex;
  align-items: center;
  flex: none;
}
.arrow-circle {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #67e8f9;
}
.arrow-dash {
  width: 60rpx;
  height: 0;
  border-top: 2rpx dashed #a78bfa;
  margin: 0 4rpx;
}
.arrow-head {
  width: 0;
  height: 0;
  border-left: 10rpx solid #a78bfa;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
}
.route-text {
  font-size: 24rpx;
  color: #c7d2fe;
}
.stub-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex: none;
}
.barcode {
  display: flex;
  align-items: flex-end;
  height: 80rpx;
  gap: 3rpx;
}
.barcode .bar {
  height: 100%;
  background: rgba(239, 234, 255, 0.85);
}
.barcode-no {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(225, 220, 255, 0.66);
}
.ticket-foot {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0 60rpx 40rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(225, 220, 255, 0.66);
}