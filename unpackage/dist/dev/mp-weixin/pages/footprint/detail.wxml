<view class="page-container"><view class="aurora"><view class="a1"></view><view class="a2"></view><view class="a3"></view></view><view wx:if="{{a}}" class="loading-box"><text>加载中...</text></view><view wx:elif="{{b}}" class="ticket"><view class="ticket-overlay"></view><view class="ticket-head"><view class="rule-line"></view><view class="diamond"></view><view class="head-text"><text class="head-cn">纪念电子票据</text><text class="head-en">MEMORIAL TICKET</text></view><view class="diamond"></view><view class="rule-line"></view></view><view class="ticket-main"><view class="event-row"><view class="rule-line short"></view><text class="event-name">{{c}}</text><view class="rule-line short reverse"></view></view><text class="artist">{{d}}</text><text class="artist-en">{{e}}</text><view class="date-row"><text class="date-num">{{f}}</text><text class="date-dot">·</text><text class="date-num">{{g}}</text><text class="date-dot">·</text><text class="date-num">{{h}}</text></view><view class="divider"></view><view class="info-grid"><view class="info"><text class="info-dt">持有者</text><text class="info-dd">{{i}}</text></view><view class="info"><text class="info-dt">场次</text><text class="info-dd">第 {{j}} 场</text></view><view class="info"><text class="info-dt">地点</text><text class="info-dd">{{k}}</text></view><view class="info"><text class="info-dt">出发 & 到达</text><text class="info-dd">{{l}}-{{m}} <text class="tag">{{n}}</text></text></view></view></view><view class="perforation"><view class="notch l"></view><view class="perf-line"></view><view class="mid-dot"></view><view class="perf-line"></view><view class="notch r"></view><view class="stamp"><text class="stamp-cn">已奔赴</text><text class="stamp-sub">到场看完演出</text></view></view><view class="ticket-stub"><view class="stub-left"><text class="stub-label">副券 · 留存纪念</text><text class="stub-no">NO.<text class="stub-num">{{o}}</text></text></view><view class="stub-right"><view class="barcode"><view wx:for="{{p}}" wx:for-item="w" wx:key="a" class="bar" style="{{'width:' + w.b}}"></view></view><text class="barcode-no">192769QY</text></view></view><view class="stub-route"><view class="route-arrow"><view class="arrow-circle"></view><view class="arrow-dash"></view><view class="arrow-head"></view></view><text class="route-text">{{q}} → {{r}}省{{s}}</text><text class="tag">{{t}}</text></view><text class="ticket-foot">纪念电子票据 · 仅供收藏留念</text></view><view wx:else class="empty-box"><text>未找到该记录</text></view></view>