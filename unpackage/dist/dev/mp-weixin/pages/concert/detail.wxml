<view class="page-container"><view wx:if="{{a}}" class="loading-box"><text>加载中...</text></view><view wx:elif="{{b}}" class="detail-box"><view class="type-header"><view class="{{['type-tag', d]}}">{{c}}</view></view><view class="info-card"><view class="card-row"><text class="card-label">主题</text><text class="card-value">{{e}}</text></view><view class="card-row"><text class="card-label">场馆</text><text class="card-value">{{f}}</text></view><view class="card-row"><text class="card-label">场次</text><text class="card-value">{{g}}</text></view><view class="card-row"><text class="card-label">时间</text><text class="card-value">{{h}}</text></view><view class="card-row"><text class="card-label">省份</text><text class="card-value">{{i}}</text></view><view class="card-row"><text class="card-label">地址</text><text class="card-value">{{j}}</text></view><view wx:if="{{k}}" class="card-row"><text class="card-label">歌单</text><text class="card-value playlist">{{l}}</text></view><view wx:if="{{m}}" class="card-row"><text class="card-label">备注</text><text class="card-value">{{n}}</text></view></view></view><view wx:else class="empty-box"><text>未找到该记录</text></view></view>