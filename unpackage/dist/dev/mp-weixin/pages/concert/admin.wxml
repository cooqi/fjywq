<view class="page-container"><view wx:if="{{a}}" class="action-box"><button class="add-btn" bindtap="{{b}}">+ 添加演唱会/音乐节</button></view><view class="filter-box"><view class="filter-item"><text>类型：</text><picker bindchange="{{d}}" value="{{e}}" range="{{f}}" range-key="label"><view class="picker">{{c}}</view></picker></view><view class="search-box"><input class="search-input" placeholder="搜索主题/场馆/地址" bindconfirm="{{g}}" value="{{h}}" bindinput="{{i}}"/><view class="search-btn" bindtap="{{j}}">搜索</view></view></view><view class="list-box"><view class="list-header"><text class="count">共 {{k}} 条记录</text></view><view wx:for="{{l}}" wx:for-item="item" wx:key="l" class="concert-item" bindtap="{{item.m}}"><view class="item-header"><view class="{{['item-type', item.b]}}">{{item.a}}</view><view wx:if="{{m}}" class="item-actions"><view class="action-btn edit" bindtap="{{item.c}}">编辑</view><view class="action-btn delete" bindtap="{{item.d}}">删除</view></view></view><view class="item-content"><view class="item-row"><text class="label">主题：</text><text class="value">{{item.e}}</text></view><view class="item-row"><text class="label">场馆：</text><text class="value">{{item.f}}</text></view><view class="item-row"><text class="label">场次：</text><text class="value">{{item.g}}</text></view><view class="item-row"><text class="label">时间：</text><text class="value">{{item.h}}</text></view><view class="item-row"><text class="label">地址：</text><text class="value">{{item.i}}</text></view><view wx:if="{{item.j}}" class="item-row"><text class="label">备注：</text><text class="value">{{item.k}}</text></view></view></view><view wx:if="{{n}}" class="empty-box"><text class="empty-text">暂无数据</text></view><view wx:if="{{o}}" class="load-more"><text bindtap="{{p}}">加载更多</text></view></view><uni-popup wx:if="{{R}}" class="r" u-s="{{['d']}}" u-r="popup" u-i="6fbbadc0-0" bind:__l="__l" u-p="{{R}}"><view class="dialog-box"><view class="dialog-title">{{q}}演唱会/音乐节</view><view class="form-box"><view class="form-item"><text class="form-label">类型 <text class="required">*</text></text><picker bindchange="{{s}}" value="{{t}}" range="{{v}}" range-key="label"><view class="form-picker">{{r}}</view></picker></view><view class="form-item"><text class="form-label">主题</text><input class="form-input" placeholder="请输入演唱会主题" value="{{w}}" bindinput="{{x}}"/></view><view class="form-item"><text class="form-label">场馆</text><input class="form-input" placeholder="请输入演唱会场馆" value="{{y}}" bindinput="{{z}}"/></view><view class="form-item"><text class="form-label">场次</text><input class="form-input" placeholder="例如：D1、D2" value="{{A}}" bindinput="{{B}}"/></view><view class="form-item"><text class="form-label">时间</text><uni-datetime-picker wx:if="{{D}}" u-i="6fbbadc0-1,6fbbadc0-0" bind:__l="__l" bindupdateModelValue="{{C}}" u-p="{{D}}"/></view><view class="form-item"><text class="form-label">省份 <text class="required">*</text></text><picker bindchange="{{F}}" value="{{G}}" range="{{H}}"><view class="form-picker">{{E}}</view></picker></view><view class="form-item"><text class="form-label">详细地址</text><input class="form-input" placeholder="请输入详细地址" value="{{I}}" bindinput="{{J}}"/></view><view class="form-item"><text class="form-label">歌单</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="请输入歌单内容" value="{{K}}" bindinput="{{L}}"/></block></view><view class="form-item"><text class="form-label">备注</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="请输入备注信息" value="{{M}}" bindinput="{{N}}"/></block></view></view><view class="dialog-actions"><button class="cancel-btn" bindtap="{{O}}">取消</button><button class="submit-btn" bindtap="{{P}}">保存</button></view></view></uni-popup></view>