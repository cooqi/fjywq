{
  "bsonType": "object",
  "required": ["user_id", "name"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "ID，系统自动生成" },
    "user_id": { "bsonType": "string", "description": "所属用户ID（uni-id-users _id）" },
    "name": { "bsonType": "string", "description": "杯蜜名字", "maxLength": 24 },
    "emoji": { "bsonType": "string", "description": "杯蜜形象 Emoji（降级展示）" },
    "look": { "bsonType": "object", "description": "自定义形象（ren.html 霓虹线条风）{ver:3,gender:'m'|'f',skin,clothColor,hairColor,hair,outfit}；clothColor/hairColor 限云函数 LOOK_PARTS.themeColors 8 色调色板，hair 为可选部件（none 默认无发/short/long），配饰色自动取 clothColor；线条色由 gender 固定；表情由 mood 推导不入库，配饰在 equippedItems" },
    "gender": { "bsonType": "string", "description": "性别" },
    "age": { "bsonType": "int", "description": "年龄" },
    "height": { "bsonType": "int", "description": "身高" },
    "weight": { "bsonType": "int", "description": "当前体重 kg（吃太多会涨，生病会掉）" },
    "weightBase": { "bsonType": "int", "description": "基础体重 kg（领养时确定，用于限制胖瘦浮动区间）" },
    "overKcal": { "bsonType": "int", "description": "未消化完的多余热量累计，每满云函数 rules.FAT_KCAL_PER_KG 则体重 +1kg" },
    "likes": { "bsonType": "array", "description": "喜好列表，可用于互动" },
    "job": { "bsonType": "string", "description": "职业：doctor/teacher/postman，空表示无职业" },
    "interaction": { "bsonType": "int", "description": "互动值 0-100", "minimum": 0, "maximum": 100 },
    "health": { "bsonType": "int", "description": "健康值 0-100", "minimum": 0, "maximum": 100 },
    "happiness": { "bsonType": "int", "description": "开心值 0-100（离线每小时 -1）", "minimum": 0, "maximum": 100 },
    "hunger": { "bsonType": "int", "description": "饥饿值 0-100，数值越大越饿（离线每小时上升，只有休息时可吃东西）", "minimum": 0, "maximum": 100 },
    "mood": { "bsonType": "string", "description": "心情：happy/normal/unhappy/sick/recovering（sick=过劳/作息紊乱需调养）" },
    "status": { "bsonType": "string", "description": "当前状态：idle/working/resting/sleeping/leave/traveling/absent（由日程+请假+旅行实时推导）" },
    "leave": { "bsonType": "object", "description": "请假状态 {type:personal|sick,startAt,endAt,reason}" },
    "restInteract": { "bsonType": "object", "description": "休息期互动节流 {at,count}，用于过度互动扣健康" },
    "wallet": { "bsonType": "object", "description": "工资台账 {todayWage,lastSettleDate}" },
    "absentLog": { "bsonType": "array", "description": "旷工日期列表 [dateStr]" },
        "workPlan": { "bsonType": "object", "description": "上班时段计划 {shiftKey:选定的职业班次key(空=全部), customShifts:[{name,start,end,weekdays}] 仅自由职业使用}" },
        "sleepPlan": { "bsonType": "object", "description": "自定义睡眠 {on,start,end,weekdays}，on=true 覆盖全局默认睡眠时段" },
    "growth": { "bsonType": "int", "description": "成长值" },
    "level": { "bsonType": "int", "description": "等级" },
    "heart": { "bsonType": "int", "description": "爱心（免费资源）" },
    "coin": { "bsonType": "int", "description": "杯蜜币（工作获得，看病外聘医生消耗）" },
    "friendCode": { "bsonType": "string", "description": "杯蜜唯一编码，用于加好友" },
    "friends": { "bsonType": "array", "description": "好友杯蜜列表（双方互见，同意后写入） [{friendCode,name,emoji,since}]" },
    "workStarted": { "bsonType": "bool", "description": "是否已开始过工作（用于记录第一次工作日记）" },
    "lastCalcAt": { "bsonType": "timestamp", "description": "最后一次状态计算时间" },
    "lastInteractAt": { "bsonType": "timestamp", "description": "最后一次互动时间" },
    "lastActionAt": { "bsonType": "object", "description": "各动作上次执行时间" },
    "recoveringUntil": { "bsonType": "timestamp", "description": "恢复中截止时间" },
    "lowIntimacySince": { "bsonType": "timestamp", "description": "互动值持续偏低的起始时间（用于生病判定）" },
    "sickAt": { "bsonType": "timestamp", "description": "进入生病时间" },
    "care": { "bsonType": "object", "description": "诊所护理进度 {done:[],lastCareAt}" },
    "daily": { "bsonType": "object", "description": "当日计数 {date,actions,variety,interact,login,help,heal,disturb,chat,meals}" },
    "tasksClaimed": { "bsonType": "object", "description": "已领取任务奖励标记" },
    "work": { "bsonType": "object", "description": "工作状态 {lastWorkDate,state}" },
    "travel": { "bsonType": "object", "description": "旅行状态 {place,placeName,endAt,startAt}" },
    "equippedItems": { "bsonType": "array", "description": "当前穿戴的装扮 key 列表" },
    "streak": { "bsonType": "int", "description": "连续陪伴天数" },
    "lastVisitDate": { "bsonType": "string", "description": "上次访问日期" },
    "lastNotifyDate": { "bsonType": "string", "description": "上次发送提醒日期" },
    "decorUnlocked": { "bsonType": "array", "description": "已解锁装扮" },
    "notifyOn": { "bsonType": "bool", "description": "是否开启订阅提醒" },
    "adoptAt": { "bsonType": "timestamp", "description": "领养时间" },
    "create_date": { "bsonType": "timestamp", "description": "创建时间", "forceDefaultValue": { "$env": "now" } }
  }
}
