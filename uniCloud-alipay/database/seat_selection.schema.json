{
	"bsonType": "object",
	"required": ["concertId", "areaId", "row", "col"],
	"permission": {
		"read": true,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"concertId": {
			"bsonType": "string",
			"description": "所属演唱会ID",
			"foreignKey": "Concert._id"
		},
		"areaId": {
			"bsonType": "string",
			"description": "分区ID",
			"foreignKey": "seat_area._id"
		},
		"row": {
			"bsonType": "int",
			"description": "第几排，从1开始",
			"minimum": 1
		},
		"col": {
			"bsonType": "int",
			"description": "第几列，从1开始",
			"minimum": 1
		},
		"seatLabel": {
			"bsonType": "string",
			"description": "冗余展示文本，如：A区3排5号",
			"trim": "both"
		},
		"remark": {
			"bsonType": "string",
			"description": "选座人备注（脱敏公开，展示在座位上）",
			"maxLength": 100,
			"defaultValue": "",
			"trim": "both"
		},
		"userId": {
			"bsonType": "string",
			"description": "选座人用户ID（user-info._id）",
			"forceDefaultValue": ""
		},
		"nickname": {
			"bsonType": "string",
			"description": "选座人昵称（脱敏后展示用）",
			"defaultValue": "",
			"trim": "both"
		},
		"avatar": {
			"bsonType": "string",
			"description": "选座人头像",
			"defaultValue": "",
			"trim": "both"
		},
		"source": {
			"bsonType": "int",
			"description": "来源：1=用户选座 2=管理员后台录入",
			"defaultValue": 1,
			"enum": [
				{ "text": "用户选座", "value": 1 },
				{ "text": "管理员后台", "value": 2 }
			]
		},
		"createTime": {
			"bsonType": "timestamp",
			"description": "选座时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
