{
  "bsonType": "object",
  "required": ["pet_id", "role"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "ID，系统自动生成" },
    "pet_id": { "bsonType": "string", "description": "杯蜜ID" },
    "role": { "bsonType": "string", "description": "消息来源：user(用户) / beemore(杯蜜)" },
    "text": { "bsonType": "string", "description": "用户发送的自定义内容（杯蜜消息可空）" },
    "emoticon": { "bsonType": "string", "description": "杯蜜回复的颜文字" },
    "state": { "bsonType": "string", "description": "杯蜜回复时所处的状态：idle/working/resting/sleeping/traveling/leave" },
    "queued": { "bsonType": "bool", "description": "是否为工作/睡觉期间的留言（未即时回复）" },
    "create_date": { "bsonType": "timestamp", "description": "记录时间", "forceDefaultValue": { "$env": "now" } }
  }
}
