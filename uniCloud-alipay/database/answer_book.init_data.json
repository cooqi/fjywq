[
	{ "text": "就是现在，去做", "category": "行动建议", "weight": 2 },
	{ "text": "不妨再主动一点", "category": "行动建议", "weight": 1 },
	{ "text": "先迈出一小步，剩下的会清晰起来", "category": "行动建议", "weight": 1 },
	{ "text": "今天联系TA，会有好结果", "category": "行动建议", "weight": 1 },
	{ "text": "把想法说出来，别憋着", "category": "行动建议", "weight": 1 },
	{ "text": "列个清单，从最容易的开始", "category": "行动建议", "weight": 1 },
	{ "text": "睡一觉，明天早上再决定", "category": "行动建议", "weight": 2 },
	{ "text": "找信得过的人聊聊", "category": "行动建议", "weight": 1 },
	{ "text": "先照顾好身体，答案自然会来", "category": "行动建议", "weight": 1 },
	{ "text": "把手机放下，这件事不急", "category": "行动建议", "weight": 1 },
	{ "text": "试一次不会怎样，不试才会惦记", "category": "行动建议", "weight": 1 },
	{ "text": "今天先把那件拖了很久的事做掉", "category": "行动建议", "weight": 1 },
	{ "text": "约TA出来走走，线下更真实", "category": "行动建议", "weight": 1 },
	{ "text": "记下此刻的想法，一周后再看", "category": "行动建议", "weight": 1 },
	{ "text": "去付款吧，你值得", "category": "行动建议", "weight": 1 },
	{ "text": "再等一个合适的时机也不迟", "category": "行动建议", "weight": 1 },
	{ "text": "从源头解决，别再修补表面", "category": "行动建议", "weight": 1 },
	{ "text": "给自己放半天假，回来效率更高", "category": "行动建议", "weight": 1 },
	{ "text": "先做完，再追求做好", "category": "行动建议", "weight": 1, "interpretation": "完成比完美更重要，先跑起来，路上再调整姿势。" },
	{ "text": "主动示好不是认输，是珍惜", "category": "行动建议", "weight": 1 },
	{ "text": "是的，你的直觉没错", "category": "现状确认", "weight": 2 },
	{ "text": "已经在变好的路上了", "category": "现状确认", "weight": 2 },
	{ "text": "你担心的事，多半不会发生", "category": "现状确认", "weight": 1 },
	{ "text": "方向是对的，别总回头看", "category": "现状确认", "weight": 1 },
	{ "text": "一切都在悄悄安排妥当", "category": "现状确认", "weight": 1 },
	{ "text": "你比自己以为的更强大", "category": "现状确认", "weight": 1 },
	{ "text": "这段关系比你想象的稳固", "category": "现状确认", "weight": 1 },
	{ "text": "现在的停顿，只是蓄力", "category": "现状确认", "weight": 1 },
	{ "text": "你的努力，有人看在眼里", "category": "现状确认", "weight": 1 },
	{ "text": "这不是坏运气，是好转折的前奏", "category": "现状确认", "weight": 1 },
	{ "text": "你值得喜欢，别怀疑", "category": "现状确认", "weight": 1 },
	{ "text": "局面没有你想的那么糟", "category": "现状确认", "weight": 1 },
	{ "text": "你其实早有答案，只是想找人确认", "category": "现状确认", "weight": 2, "interpretation": "翻到这一页时你心里是不是已经亮了一下？那就是你的答案。" },
	{ "text": "慢慢来，是目前最快的方式", "category": "现状确认", "weight": 1 },
	{ "text": "被需要的感觉，说明你很重要", "category": "现状确认", "weight": 1 },
	{ "text": "这件事已经过去了，不用再背了", "category": "现状确认", "weight": 1 },
	{ "text": "你没有错过，只是还在路上", "category": "现状确认", "weight": 1 },
	{ "text": "你的担心本身就是在乎的证明", "category": "现状确认", "weight": 1 },
	{ "text": "关系没有变淡，只是变得更日常", "category": "现状确认", "weight": 1 },
	{ "text": "答案是肯定的", "category": "现状确认", "weight": 2 },
	{ "text": "TA也在想着你", "category": "感情关系", "weight": 1 },
	{ "text": "喜欢就说，憋久了会变成委屈", "category": "感情关系", "weight": 1 },
	{ "text": "给彼此一点空间，会更近", "category": "感情关系", "weight": 1 },
	{ "text": "别用试探验证爱，用沟通", "category": "感情关系", "weight": 1 },
	{ "text": "把期待说出来，对方才接得住", "category": "感情关系", "weight": 1 },
	{ "text": "这一次，换你先低头也无妨", "category": "感情关系", "weight": 1 },
	{ "text": "记得问问TA，而不是猜TA", "category": "感情关系", "weight": 1 },
	{ "text": "小吵怡情，翻旧账才伤感情", "category": "感情关系", "weight": 1 },
	{ "text": "纪念日不必隆重，用心就够", "category": "感情关系", "weight": 1 },
	{ "text": "先处理情绪，再处理问题", "category": "感情关系", "weight": 1 },
	{ "text": "你们需要一次不谈正事的约会", "category": "感情关系", "weight": 1 },
	{ "text": "被爱是运气，爱是能力，你两样都有", "category": "感情关系", "weight": 1 },
	{ "text": "别拿别人的尺子量自己的感情", "category": "感情关系", "weight": 1 },
	{ "text": "放下手机，认真看一眼身边的人", "category": "感情关系", "weight": 1 },
	{ "text": "该主动道歉的是先长大的那个", "category": "感情关系", "weight": 1 },
	{ "text": "你的真心，配得上坦白的回应", "category": "感情关系", "weight": 1 },
	{ "text": "旧的人离开，是为了给对的人让路", "category": "感情关系", "weight": 1 },
	{ "text": "多拍点合照，以后都是宝贝", "category": "感情关系", "weight": 1 },
	{ "text": "爱要趁热，别等到冷场", "category": "感情关系", "weight": 1 },
	{ "text": "信一次，但带着脑子信", "category": "感情关系", "weight": 1 },
	{ "text": "你怕的事，说出来就没那么可怕", "category": "勇气激励", "weight": 1 },
	{ "text": "去报名，别等准备好", "category": "勇气激励", "weight": 1 },
	{ "text": "举手说出你的想法，它值得被听见", "category": "勇气激励", "weight": 1 },
	{ "text": "最坏的结果，你也耗得起", "category": "勇气激励", "weight": 1 },
	{ "text": "失败了算我的，去试", "category": "勇气激励", "weight": 2, "interpretation": "书页替你壮胆。真出了事，大不了重来，你还输得起。" },
	{ "text": "别人怎么看，是别人的事", "category": "勇气激励", "weight": 1 },
	{ "text": "你缺的不是能力，是上桌的勇气", "category": "勇气激励", "weight": 1 },
	{ "text": "现在不说，以后会后悔", "category": "勇气激励", "weight": 1 },
	{ "text": "怕，就带着怕往前走", "category": "勇气激励", "weight": 1 },
	{ "text": "退路留一条就够了，留十条哪儿也去不了", "category": "勇气激励", "weight": 1 },
	{ "text": "你可以拒绝，不用解释太多", "category": "勇气激励", "weight": 1 },
	{ "text": "丢脸是一时的，错过是长期的", "category": "勇气激励", "weight": 1 },
	{ "text": "换个环境吧，你值得更大的池子", "category": "勇气激励", "weight": 1 },
	{ "text": "把「我不行」换成「我还没练」", "category": "勇气激励", "weight": 1 },
	{ "text": "去做那个没人敢做的选择", "category": "勇气激励", "weight": 1 },
	{ "text": "你的声音不大，但很必要", "category": "勇气激励", "weight": 1 },
	{ "text": "再被拒绝一次，就凑齐经验了", "category": "勇气激励", "weight": 1 },
	{ "text": "赢过一次的自己，就敢赢第二次", "category": "勇气激励", "weight": 1 },
	{ "text": "今天硬气一次，明天就习惯一次", "category": "勇气激励", "weight": 1 },
	{ "text": "赌一把小的，攒点手气", "category": "勇气激励", "weight": 1 },
	{ "text": "你已经撑过很多难的了，不差这一次", "category": "勇气激励", "weight": 1 },
	{ "text": "没关系，真的会没关系", "category": "治愈安慰", "weight": 2 },
	{ "text": "今天辛苦了，早点休息", "category": "治愈安慰", "weight": 2 },
	{ "text": "哭完记得喝口热水", "category": "治愈安慰", "weight": 1 },
	{ "text": "慢一点也没关系，你在自己的时区", "category": "治愈安慰", "weight": 1 },
	{ "text": "吃点好的，胃暖了心就暖了", "category": "治愈安慰", "weight": 1 },
	{ "text": "这不是你的错，别都往身上揽", "category": "治愈安慰", "weight": 1 },
	{ "text": "太阳下山有月亮，月亮落下有星星", "category": "治愈安慰", "weight": 1 },
	{ "text": "允许自己今天什么都不做", "category": "治愈安慰", "weight": 1 },
	{ "text": "难过说明你还在认真生活", "category": "治愈安慰", "weight": 1 },
	{ "text": "抱一下，隔着书页的那种", "category": "治愈安慰", "weight": 1 },
	{ "text": "会过去的，之前的都过去了", "category": "治愈安慰", "weight": 1 },
	{ "text": "你已经做得很好了", "category": "治愈安慰", "weight": 2 },
	{ "text": "把被子晒一晒，今晚做个好梦", "category": "治愈安慰", "weight": 1 },
	{ "text": "没有人规定每天都要有进步", "category": "治愈安慰", "weight": 1 },
	{ "text": "深呼吸，一次只处理一件事", "category": "治愈安慰", "weight": 1 },
	{ "text": "世界很吵，你可以先关门", "category": "治愈安慰", "weight": 1 },
	{ "text": "那些没结果的付出，也算数", "category": "治愈安慰", "weight": 1 },
	{ "text": "去吹吹风，风会带走一半烦恼", "category": "治愈安慰", "weight": 1 },
	{ "text": "对自己说声：辛苦了，我陪你", "category": "治愈安慰", "weight": 1 },
	{ "text": "明天新的一天，重新开局", "category": "治愈安慰", "weight": 1 },
	{ "text": "两条路都通向好结局，选心动的", "category": "方向指引", "weight": 1 },
	{ "text": "别在两个选择间反复，先选的那个更接近真心", "category": "方向指引", "weight": 1 },
	{ "text": "往人少的地方走，机会在那", "category": "方向指引", "weight": 1 },
	{ "text": "学那个让你着迷的东西", "category": "方向指引", "weight": 1 },
	{ "text": "把钱投资在自己身上，稳赚", "category": "方向指引", "weight": 1 },
	{ "text": "选让你睡得着觉的那个方案", "category": "方向指引", "weight": 1 },
	{ "text": "去见没见过的人，去看没去过的地方", "category": "方向指引", "weight": 1 },
	{ "text": "兴趣是第一线索，顺着它摸", "category": "方向指引", "weight": 1 },
	{ "text": "重要不紧急的事，优先做", "category": "方向指引", "weight": 1 },
	{ "text": "答案不在信息里，在你安静下来时", "category": "方向指引", "weight": 1 },
	{ "text": "先积累作品，机会看作品说话", "category": "方向指引", "weight": 1 },
	{ "text": "哪个选择让你更期待未来，就选哪个", "category": "方向指引", "weight": 1 },
	{ "text": "少听建议，多看做成的人怎么做", "category": "方向指引", "weight": 1 },
	{ "text": "往让你成长的方向，哪怕麻烦一点", "category": "方向指引", "weight": 1 },
	{ "text": "三十七度二的人生，留一点余地", "category": "方向指引", "weight": 1 },
	{ "text": "别追风口，追你自己的热爱", "category": "方向指引", "weight": 1 },
	{ "text": "方向定了，细节可以慢慢调", "category": "方向指引", "weight": 1 },
	{ "text": "把大目标切成小块，一块一块吃", "category": "方向指引", "weight": 1 },
	{ "text": "走进那条你觉得窄但亮的路", "category": "方向指引", "weight": 1 },
	{ "text": "你的热爱里藏着你该走的方向", "category": "方向指引", "weight": 1, "interpretation": "别把它当爱好就划掉，它可能正是你该认真经营的事。" },
	{ "text": "值得的东西，多等一会儿不亏", "category": "延迟满足", "weight": 1 },
	{ "text": "再攒一攒，时机未到", "category": "延迟满足", "weight": 1 },
	{ "text": "让子弹飞一会儿", "category": "延迟满足", "weight": 2 },
	{ "text": "下个月再买，还想要就买", "category": "延迟满足", "weight": 1 },
	{ "text": "先把基础打牢，楼自然往上盖", "category": "延迟满足", "weight": 1 },
	{ "text": "现在拒绝，是为了以后不后悔", "category": "延迟满足", "weight": 1 },
	{ "text": "慢就是快，别跳步骤", "category": "延迟满足", "weight": 1 },
	{ "text": "这份感情值得慢慢经营", "category": "延迟满足", "weight": 1 },
	{ "text": "先存一笔「随时可以说不」的钱", "category": "延迟满足", "weight": 1 },
	{ "text": "再读一本书再决定，不亏", "category": "延迟满足", "weight": 1 },
	{ "text": "好的果子和晒透的太阳，都需要时间", "category": "延迟满足", "weight": 1 },
	{ "text": "把这次的教训记下来，下次就是资历", "category": "延迟满足", "weight": 1 },
	{ "text": "等情绪过去，再做重要决定", "category": "延迟满足", "weight": 1 },
	{ "text": "与其急着开始，不如先想清楚为什么", "category": "延迟满足", "weight": 1 },
	{ "text": "再观察一轮，人心经得起时间", "category": "延迟满足", "weight": 1 },
	{ "text": "你现在种的草，以后会成风景", "category": "延迟满足", "weight": 1 },
	{ "text": "把愿望写下来，一年后来翻", "category": "延迟满足", "weight": 1 },
	{ "text": "火候不到，添柴没用", "category": "延迟满足", "weight": 1 },
	{ "text": "先深耕，再谈收获", "category": "延迟满足", "weight": 1 },
	{ "text": "过三周还想做，才是真想做", "category": "延迟满足", "weight": 1 },
	{ "text": "回头看看，你已经走了很远", "category": "回顾反思", "weight": 1 },
	{ "text": "答案藏在上次那件事里", "category": "回顾反思", "weight": 1 },
	{ "text": "想想三年前你怎么过来的", "category": "回顾反思", "weight": 1 },
	{ "text": "你的老毛病，这次又露头了", "category": "回顾反思", "weight": 1 },
	{ "text": "翻翻旧照片，初心还在不在", "category": "回顾反思", "weight": 1 },
	{ "text": "哪件事你反复提起，哪件事就该处理", "category": "回顾反思", "weight": 1 },
	{ "text": "当初出发的理由，还记得吗", "category": "回顾反思", "weight": 1 },
	{ "text": "谢谢你当时没有放弃", "category": "回顾反思", "weight": 1 },
	{ "text": "犯过的错可以重复利用，变成经验", "category": "回顾反思", "weight": 1 },
	{ "text": "把道歉补上，哪怕已经晚了", "category": "回顾反思", "weight": 1 },
	{ "text": "旧朋友该联系了", "category": "回顾反思", "weight": 1 },
	{ "text": "你怀念的不是过去，是那时的松弛", "category": "回顾反思", "weight": 1 },
	{ "text": "复盘一次，胜过焦虑十天", "category": "回顾反思", "weight": 1 },
	{ "text": "从没有白走的路，弯也算数", "category": "回顾反思", "weight": 1 },
	{ "text": "翻翻去年的日记，你会笑出来", "category": "回顾反思", "weight": 1 },
	{ "text": "放下沉没成本，昨天不算数", "category": "回顾反思", "weight": 1 },
	{ "text": "把感谢说给那个帮过你的人", "category": "回顾反思", "weight": 1 },
	{ "text": "你早已解决过同类问题，这次也会", "category": "回顾反思", "weight": 1 },
	{ "text": "该告别的，体面地告别", "category": "回顾反思", "weight": 1 },
	{ "text": "记住此刻的感觉，它是路标", "category": "回顾反思", "weight": 1 },
	{ "text": "先做5分钟，再决定要不要继续", "category": "行动建议", "weight": 1 },
	{ "text": "把第一步拆到小到不可能失败", "category": "行动建议", "weight": 1 },
	{ "text": "现在就开始，别等状态完美", "category": "行动建议", "weight": 1 },
	{ "text": "去问那个懂的人，比自己憋快", "category": "行动建议", "weight": 1 },
	{ "text": "先把桌面清理干净，心就静了", "category": "行动建议", "weight": 1 },
	{ "text": "今天只做三件事，够了", "category": "行动建议", "weight": 1 },
	{ "text": "发出去那条消息，别再删了", "category": "行动建议", "weight": 1 },
	{ "text": "去报名，名额不等人", "category": "行动建议", "weight": 1 },
	{ "text": "先记账，钱花在哪一目了然", "category": "行动建议", "weight": 1 },
	{ "text": "把闹钟提前十分钟，从容一整天", "category": "行动建议", "weight": 1 },
	{ "text": "去把那本书翻开第一章", "category": "行动建议", "weight": 1 },
	{ "text": "当面说清楚，别只留文字", "category": "行动建议", "weight": 1 },
	{ "text": "先睡够，再做决定不迟", "category": "行动建议", "weight": 1 },
	{ "text": "把「改天」换成具体日期", "category": "行动建议", "weight": 1 },
	{ "text": "现在就动身，路上会想明白", "category": "行动建议", "weight": 1 },
	{ "text": "删掉干扰，一次只做一件事", "category": "行动建议", "weight": 1 },
	{ "text": "先帮别人一次，关系就活了", "category": "行动建议", "weight": 1 },
	{ "text": "拍下灵感，别相信记忆力", "category": "行动建议", "weight": 1 },
	{ "text": "从今天起，每天进步一点点", "category": "行动建议", "weight": 1 },
	{ "text": "把目标念出声，像已经实现", "category": "行动建议", "weight": 1 },
	{ "text": "先去运动，烦恼会跟着出汗", "category": "行动建议", "weight": 1 },
	{ "text": "该修的东西今天修，别拖", "category": "行动建议", "weight": 1 },
	{ "text": "把感谢当面说给TA听", "category": "行动建议", "weight": 1 },
	{ "text": "先完成一次，再谈习惯", "category": "行动建议", "weight": 1 },
	{ "text": "去尝尝那家新开的店，犒赏自己", "category": "行动建议", "weight": 1 },
	{ "text": "把手机放远，专注二十分钟", "category": "行动建议", "weight": 1 },
	{ "text": "先写下三件顺利的小事", "category": "行动建议", "weight": 1 },
	{ "text": "该学的技能，现在搜教程", "category": "行动建议", "weight": 1 },
	{ "text": "认真做顿饭，照顾好自己的胃", "category": "行动建议", "weight": 1 },
	{ "text": "先迈出家门，机会在门外", "category": "行动建议", "weight": 1 },
	{ "text": "你正走在对的方向上", "category": "现状确认", "weight": 1 },
	{ "text": "情况比你感觉的要乐观", "category": "现状确认", "weight": 1 },
	{ "text": "你担心的转折其实是机遇", "category": "现状确认", "weight": 1 },
	{ "text": "一切正在暗中生长", "category": "现状确认", "weight": 1 },
