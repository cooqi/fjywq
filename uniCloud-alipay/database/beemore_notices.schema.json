{
  "bsonType": "object",
  "required": ["pet_id", "type", "text"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "description": "ID，系统自动生成" },
    "pet_id": { "bsonType": "string", "description": "接收方杯蜜ID" },
    "user_id": { "bsonType": "string", "description": "接收方用户ID（便于按用户查询）" },
    "type": { "bsonType": "string", "description": "消息类型：friend_apply=好友申请 / heart=好友送关心" },
    "title": { "bsonType": "string", "description": "消息标题" },
    "text": { "bsonType": "string", "description": "消息正文" },
    "from_pet": { "bsonType": "string", "description": "发起方杯蜜ID" },
    "from_code": { "bsonType": "string", "description": "发起方杯蜜编码" },
    "from_name": { "bsonType": "string", "description": "发起方杯蜜名字" },
    "from_emoji": { "bsonType": "string", "description": "发起方杯蜜emoji" },
    "link": { "bsonType": "string", "description": "点击跳转目标页（如 friends）" },
    "read": { "bsonType": "bool", "description": "是否已读" },
    "create_date": { "bsonType": "timestamp", "description": "记录时间", "forceDefaultValue": { "$env": "now" } }
  }
}
