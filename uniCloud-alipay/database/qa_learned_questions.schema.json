{
    "bsonType": "object",
    "required": ["user_id", "question_id"],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID，系统自动生成"
        },
        "user_id": {
            "bsonType": "string",
            "description": "用户ID"
        },
        "question_id": {
            "bsonType": "string",
            "description": "题目ID"
        },
        "learned_date": {
            "bsonType": "timestamp",
            "description": "标记为已学会的时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}
