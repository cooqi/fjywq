{
	"bsonType": "object",
	"required": ["exam_code", "nick", "score"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"exam_code": {
			"bsonType": "string",
			"description": "所属考试码"
		},
		"user_id": {
			"bsonType": "string",
			"description": "答题用户ID（游客为空）"
		},
		"nick": {
			"bsonType": "string",
			"description": "答题者昵称"
		},
		"questions": {
			"bsonType": "array",
			"description": "题目快照，含题目+用户答案+是否正确+分数"
		},
		"score": {
			"bsonType": "int",
			"description": "总得分",
			"defaultValue": 0
		},
		"correct_count": {
			"bsonType": "int",
			"description": "答对题数",
			"defaultValue": 0
		},
		"total_score": {
			"bsonType": "int",
			"description": "本场满分"
		},
		"pass_score": {
			"bsonType": "int",
			"description": "本场及格分"
		},
		"passed": {
			"bsonType": "bool",
			"description": "是否及格",
			"defaultValue": false
		},
		"title": {
			"bsonType": "string",
			"description": "获得称号"
		},
		"prize": {
			"bsonType": "string",
			"description": "获得奖品"
		},
		"rank": {
			"bsonType": "int",
			"description": "本场排名（交卷时快照，非实时）",
			"defaultValue": 0
		},
		"finish_time": {
			"bsonType": "timestamp",
			"description": "交卷时间戳，用于同分排名比较"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "开始答题时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
