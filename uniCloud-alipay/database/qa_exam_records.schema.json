{
    "bsonType": "object",
    "required": ["user_id", "questions", "score"],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID，系统自动生成"
        },
        "user_id": {
            "bsonType": "string",
            "description": "用户ID"
        },
        "questions": {
            "bsonType": "array",
            "description": "本次25题快照，含题目+用户答案+是否正确"
        },
        "score": {
            "bsonType": "int",
            "description": "得分",
            "defaultValue": 0
        },
        "correct_count": {
            "bsonType": "int",
            "description": "答对题数",
            "defaultValue": 0
        },
        "passed": {
            "bsonType": "bool",
            "description": "是否及格（>=60分）",
            "defaultValue": false
        },
        "mode": {
            "bsonType": "string",
            "description": "答题模式：normal 正常 / backtrack 回溯",
            "defaultValue": "normal"
        },
        "backtrack_k": {
            "bsonType": "int",
            "description": "回溯间隔题数 k（仅 backtrack 模式有效）",
            "defaultValue": 0
        },
        "is_deleted": {
            "bsonType": "bool",
            "description": "是否已删除（软删除标记）",
            "defaultValue": false
        },
        "create_date": {
            "bsonType": "timestamp",
            "description": "考试时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}