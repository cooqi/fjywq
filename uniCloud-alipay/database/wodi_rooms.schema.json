{
	"bsonType": "object",
	"required": ["code", "total_players", "cards"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"code": {
			"bsonType": "string",
			"description": "游戏码（6 位数字，唯一）"
		},
		"question_id": {
			"bsonType": "string",
			"description": "所用题库词条 ID"
		},
		"civilian_word": {
			"bsonType": "string",
			"description": "好人词（房间冗余，创建时快照）"
		},
		"spy_word": {
			"bsonType": "string",
			"description": "卧底词（房间冗余，创建时快照）"
		},
		"total_players": {
			"bsonType": "int",
			"description": "游戏人数（4-12）"
		},
		"spy_count": {
			"bsonType": "int",
			"description": "卧底人数"
		},
		"cards": {
			"bsonType": "array",
			"description": "牌面数组，创建时一次生成，之后不改：[{seat, word, isSpy}]",
			"arrayItemType": "object"
		},
		"joined_count": {
			"bsonType": "int",
			"description": "已加入人数（同时是下一个座位号-1），CAS 领牌依据",
			"defaultValue": 0
		},
		"status": {
			"bsonType": "string",
			"description": "状态：waiting 等待 / playing 已开始 / ended 已结束",
			"defaultValue": "waiting"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"update_date": {
			"bsonType": "timestamp",
			"description": "更新时间"
		},
		"expire_at": {
			"bsonType": "timestamp",
			"description": "过期时间戳（创建后 2 小时）"
		}
	}
}
